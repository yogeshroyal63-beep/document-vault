# Copy this file to .env before running anything.
# Matches the service defined in docker-compose.yml.
DATABASE_URL="postgresql://vault:vault@localhost:5432/document_vault?schema=public"

# Port the GraphQL server listens on.
PORT=4000

# Separate database used only by the integration test suite, so tests
# never run against your dev data. Same Postgres instance, different DB.
TEST_DATABASE_URL="postgresql://vault:vault@localhost:5432/document_vault_test?schema=public"
