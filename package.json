{
  "name": "document-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "gendb": "bun run prisma migrate deploy && bun run prisma generate",
    "migrate:dev": "bun run prisma migrate dev",
    "setup:first-run": "bun run prisma migrate dev --name init && bun run prisma generate",
    "prisma:generate": "bun run prisma generate",
    "prisma:studio": "bun run prisma studio",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test src/__tests__/unit",
    "test:integration": "bun test src/__tests__/integration",
    "sanity": "bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "graphql": "17.0.2",
    "graphql-yoga": "5.22.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "prisma": "6.19.3",
    "typescript": "^5.6.3"
  }
}
